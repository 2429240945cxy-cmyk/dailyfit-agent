# Runtime mode
DAILYFIT_MODE=demo_mock
DAILYFIT_DB_PATH=dailyfit.db
DAILYFIT_AUDIT_DIR=data/audits
DAILYFIT_CACHE_DIR=data/cache

# Aliyun Bailian / DashScope OpenAI-compatible API
# Fill these only in your local .env. Never commit real keys.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Main chat / agent model
DAILYFIT_LLM_PROVIDER=aliyun_openai
DAILYFIT_LLM_MODEL=qwen-plus

# Judge model must be different from tested model
DAILYFIT_JUDGE_PROVIDER=aliyun_openai
DAILYFIT_JUDGE_MODEL=qwen-max

# Embedding model for memory retrieval
DAILYFIT_EMBEDDING_PROVIDER=aliyun_openai
DAILYFIT_EMBEDDING_MODEL=text-embedding-v4
DAILYFIT_EMBEDDING_DIM=1024

# Nutrition data sources
USDA_API_KEY=

# Cost control
DAILYFIT_BUDGET_USD=1.00

# GitHub automation
DAILYFIT_GITHUB_MODE=auto
GITHUB_TOKEN=
GITHUB_REPO_NAME=dailyfit-agent
